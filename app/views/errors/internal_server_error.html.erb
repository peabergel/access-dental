<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 to-slate-200 p-6">
  <div class="max-w-xl w-full text-center">

    <div class="mb-6">
      <span class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-100">
        <span class="text-6xl">⚠️</span>
      </span>
    </div>

    <h1 class="text-3xl font-extrabold text-amber-500 tracking-tight">500</h1>

    <h2 class="mt-4 text-3xl font-semibold text-slate-800">
      Erreur interne du serveur
    </h2>

    <p class="mt-4 text-slate-600 leading-relaxed">
      Une erreur inattendue s’est produite.
      Notre équipe a peut-être déjà été notifiée.
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
      <%= link_to root_path,
        class: "px-6 py-3 rounded-xl bg-slate-900 text-white font-medium hover:bg-slate-800 transition duration-200 shadow-md hover:shadow-lg" do %>
        Retour à l’accueil
      <% end %>
    </div>

  </div>
</div>
